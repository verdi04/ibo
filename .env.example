# Copy to .env.local for local development (that file is gitignored) and set the same
# names in Vercel -> Settings -> Environment Variables. Never commit real values.

# Supabase (server-side client)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AES-256 key for stored playlist passwords and the pre-v2 legacy response path.
# Required in every environment - there is no built-in fallback key.
APP_SECRET_KEY=

# ECDSA P-256 handshake signing key, base64 PKCS#8 DER.
# Generated with: node scripts/gen-signing-key.mjs
# The matching public key is pinned in the Android app (NetworkUtils.SERVER_SIGNING_PUBLIC_KEY_SPKI_HEX).
IPTV_SIGNING_KEY_B64=
